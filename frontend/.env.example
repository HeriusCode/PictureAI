# Địa chỉ Backend FastAPI (Mặc định: http://localhost:8000)
VITE_API_BASE_URL=http://localhost:8000

# Bật (true) hoặc Tắt (false) chế độ dữ liệu mô phỏng (Mock Data)
# Khi đặt thành false, Frontend sẽ trực tiếp kết nối tới Backend FastAPI
VITE_USE_MOCK=true

# Khoảng thời gian Polling kiểm tra tiến trình sinh ảnh (mili-giây)
VITE_POLL_INTERVAL_MS=2500
